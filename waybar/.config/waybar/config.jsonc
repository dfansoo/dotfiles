{
  "layer": "top",
  "position": "top",
  "margin-top": 0,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["backlight", "idle_inhibitor", "mpris", "pulseaudio", "network", "cpu", "memory", "battery", "tray", "clock"],

  "hyprland/workspaces": {
    "format": "{id}",
    "persistent-workspaces": { "1": [], "2": [], "3": [], "4": [], "5": [] }
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "rewrite": { " - ": "" }
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "", "deactivated": "" }
  },
  "mpris": {
    "format": " {dynamic}",
    "format-paused": " {dynamic}",
    "max-length": 40
  },
  "backlight": {
    "device": "intel_backlight",
    "format": " {percent}%"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-disconnected": " disconnected",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "on-click": "networkmanager_dmenu"
  },
  "cpu": {
    "interval": 2,
    "format": " {usage}%"
  },
  "memory": {
    "interval": 2,
    "format": " {percentage}%"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "states": { "warning": 20, "critical": 10 }
  },
  "tray": { "spacing": 10 },
  "clock": {
    "format": " {:%H:%M   %a %d %b}",
    "tooltip-format": "{:%A, %d %B %Y}"
  }
}
