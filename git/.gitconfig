[user]
	name = dfanso
	email = leo@747.live
[init]
	defaultBranch = main
[pull]
	rebase = false
[core]
	editor = nvim
[alias]
	st = status
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
